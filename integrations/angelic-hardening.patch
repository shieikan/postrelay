+    use tokio::io::{AsyncReadExt, AsyncWriteExt};
+
+    async fn response_server(response: String, delay: Duration) -> (String, tokio::task::JoinHandle<()>) {
+        let listener = tokio::net::TcpListener::bind("127.0.0.1:0").await.unwrap();
+        let address = listener.local_addr().unwrap();
+        let task = tokio::spawn(async move {
+            let (mut stream, _) = listener.accept().await.unwrap();
+            let mut bytes = vec![0u8; 4096];
+            let _ = stream.read(&mut bytes).await;
+            tokio::time::sleep(delay).await;
+            let _ = stream.write_all(response.as_bytes()).await;
+        });
+        (format!("http://{address}/synthetic_endpoint_marker"), task)
+    }
+
+    #[tokio::test]
+    async fn accepted_webhook_response_succeeds() {
+        let (url, task) = response_server("HTTP/1.1 202 Accepted\r\nContent-Length: 0\r\nConnection: close\r\n\r\n".into(), Duration::ZERO).await;
+        let result = send_to_webhook_with_client(&serde_json::json!({"test": "synthetic_payload"}), &url, &webhook_client(WEBHOOK_TIMEOUT).unwrap()).await;
+        task.await.unwrap();
+        assert!(result.is_ok());
+    }
+
+    #[tokio::test]
+    async fn rejected_webhook_response_is_failure_and_hides_body_and_endpoint() {
+        let body = "synthetic_response_body_marker";
+        let response = format!("HTTP/1.1 503 Unavailable\r\nContent-Length: {}\r\nConnection: close\r\n\r\n{}", body.len(), body);
+        let (url, task) = response_server(response, Duration::ZERO).await;
+        let result = send_to_webhook_with_client(&serde_json::json!({"test": "synthetic_payload"}), &url, &webhook_client(WEBHOOK_TIMEOUT).unwrap()).await;
+        task.await.unwrap();
+        let error = result.unwrap_err();
+        assert!(matches!(error, AngelicAngelError::Webhook(503)));
+        let diagnostic = format!("{error} {error:?}");
+        assert!(!diagnostic.contains(body));
+        assert!(!diagnostic.contains("synthetic_endpoint_marker"));
+    }
+
+    #[tokio::test]
+    async fn webhook_redirect_is_failure_and_is_not_followed() {
+        let forbidden = tokio::net::TcpListener::bind("127.0.0.1:0").await.unwrap();
+        let location = format!("http://{}/forbidden", forbidden.local_addr().unwrap());
+        let response = format!("HTTP/1.1 307 Temporary Redirect\r\nLocation: {location}\r\nContent-Length: 0\r\nConnection: close\r\n\r\n");
+        let (url, task) = response_server(response, Duration::ZERO).await;
+        let result = send_to_webhook_with_client(&serde_json::json!({"test": "synthetic_payload"}), &url, &webhook_client(WEBHOOK_TIMEOUT).unwrap()).await;
+        task.await.unwrap();
+        assert!(matches!(result, Err(AngelicAngelError::Webhook(307))));
+        assert!(tokio::time::timeout(Duration::from_millis(50), forbidden.accept()).await.is_err());
+    }
+
+    #[tokio::test]
+    async fn webhook_timeout_is_bounded_and_diagnostic_is_redacted() {
+        assert_eq!(WEBHOOK_TIMEOUT, Duration::from_secs(10));
+        let (url, task) = response_server("HTTP/1.1 202 Accepted\r\nContent-Length: 0\r\n\r\n".into(), Duration::from_millis(200)).await;
+        let result = send_to_webhook_with_client(&serde_json::json!({"test": "synthetic_payload"}), &url, &webhook_client(Duration::from_millis(50)).unwrap()).await;
+        let error = result.unwrap_err();
+        assert!(!format!("{error} {error:?}").contains("synthetic_endpoint_marker"));
+        task.await.unwrap();
+    }
