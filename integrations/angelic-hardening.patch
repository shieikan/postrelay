+async fn send_to_webhook_with_client(payload: &serde_json::Value, webhook_url: &str, client: &Client) -> Result<()> {
+    tracing::info!("sending to webhook");
+    let response = client.post(webhook_url).json(payload).send().await?;
+    let status = response.status();
+    if !status.is_success() {
+        // Do not read or log a receiver's response body. Failure propagates to the
+        // existing notification loop, which emits NotDelivered instead of Delivered.
+        return Err(AngelicAngelError::Webhook(status.as_u16()));
+    }
+    tracing::info!(status = %status, "webhook request succeeded");
     Ok(())
 }
 
