+fn private_config_path(path: &Path) -> Result<PathBuf> {
+    if path.components().any(|part| matches!(part, Component::ParentDir)) || path.file_name().is_none() {
+        return Err(AngelicAngelError::Config("invalid config path".into()));
+    }
+    let absolute = if path.is_absolute() { path.to_path_buf() } else { std::env::current_dir()?.join(path) };
+    let parent = absolute.parent().ok_or_else(|| AngelicAngelError::Config("missing config parent".into()))?;
+    let mut checked = PathBuf::new();
+    for part in parent.components() {
+        checked.push(part.as_os_str());
+        let metadata = std::fs::symlink_metadata(&checked)?;
+        if metadata.file_type().is_symlink() || !metadata.is_dir() {
+            return Err(AngelicAngelError::Config("config parent must be an existing real directory".into()));
+        }
+    }
+    #[cfg(unix)] {
+        use std::os::unix::fs::PermissionsExt;
+        if std::fs::metadata(parent)?.permissions().mode() & 0o077 != 0 {
+            return Err(AngelicAngelError::Config("config parent must be private (0700)".into()));
+        }
+    }
+    match std::fs::symlink_metadata(&absolute) {
+        Ok(metadata) if metadata.file_type().is_symlink() || !metadata.is_file() =>
+            Err(AngelicAngelError::Config("config must be a regular file, not a link".into())),
+        Ok(_) => Ok(absolute),
+        Err(error) if error.kind() == std::io::ErrorKind::NotFound => Ok(absolute),
+        Err(error) => Err(error.into()),
+    }
+}
