+#[cfg(unix)]
+#[test]
+fn status_and_verbose_status_hide_cookie_and_subscription_values() {
+    use std::os::unix::fs::PermissionsExt;
+    let dir = std::env::temp_dir().canonicalize().unwrap().join(format!("angelic-hardening-cli-{}", uuid::Uuid::new_v4()));
+    std::fs::create_dir(&dir).unwrap();
+    std::fs::set_permissions(&dir, std::fs::Permissions::from_mode(0o700)).unwrap();
+    let path = dir.join("config.toml");
+    let data = r#"[twitter]
+auth_token = "synthetic_cookie_marker"
+ct0 = "synthetic_csrf_marker"
+[registration]
+endpoint = "https://example.invalid/synthetic_subscription_marker"
+[registration.autopush]
+uaid = "synthetic_uaid_marker"
+channel_id = "synthetic_channel_marker"
+[registration.keys]
+public_key = [1]
+private_key = [2]
+auth_secret = [3]
+"#;
+    std::fs::write(&path, data).unwrap();
+    std::fs::set_permissions(&path, std::fs::Permissions::from_mode(0o600)).unwrap();
+    for verbose in [false, true] {
+        let mut command = std::process::Command::new(env!("CARGO_BIN_EXE_angelic-angel"));
+        command.arg("--config").arg(&path);
+        if verbose { command.arg("--verbose"); }
+        let output = command.arg("status").output().unwrap();
+        assert!(output.status.success());
+        let combined = format!("{}{}", String::from_utf8_lossy(&output.stdout), String::from_utf8_lossy(&output.stderr));
+        assert!(combined.contains("values hidden"));
+        for marker in ["synthetic_cookie_marker", "synthetic_csrf_marker", "synthetic_subscription_marker", "synthetic_uaid_marker", "synthetic_channel_marker"] {
+            assert!(!combined.contains(marker));
+        }
+    }
+    std::fs::remove_dir_all(dir).unwrap();
+}
