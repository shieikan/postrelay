{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "postrelay",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-06",
  "workers_dev": true,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [{ "name": "RELAY", "class_name": "Relay" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Relay"] }],
  "observability": { "enabled": false },
  "send_metrics": false
}
