{
  "name": "postrelay-cloudflare",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "test:unit": "node --test tests/core.test.js tests/author.test.js tests/crypto.test.js tests/notifications.test.js tests/setup.test.js tests/upstream.test.js",
    "build": "wrangler deploy --dry-run --outdir dist",
    "dev": "wrangler dev --local",
    "configure": "node scripts/configure.js",
    "secrets": "node scripts/upload-secrets.js",
    "control": "node scripts/control.js",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "htmlparser2": "12.0.0"
  },
  "overrides": {
    "miniflare": { "sharp": "0.35.5" }
  },
  "devDependencies": {
    "esbuild": "0.28.1",
    "http_ece": "1.2.1",
    "miniflare": "5.20261006.0-alpha",
    "wrangler": "4.148.0"
  }
}
